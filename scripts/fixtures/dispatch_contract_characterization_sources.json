        "factory_kwargs": ["on_thread_id", "resume_thread_id"],
        "resume_value": null,
        "probe_spawns": 0,
        "pre_dispatch_guard": false,
        "policy_block": "clean_return_rc_1"
      }
    },
    "resume": {
