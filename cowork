#!/usr/bin/env python3
"""cowork — agent-driven multi-role orchestration entry point.

Thin shim that dispatches to scripts/cowork.py. Invoked by an orchestrating
agent with arguments; it never prompts:

    # New session: transcript on stderr, one JSON run-result line on stdout
    # (its rc equals the exit status).
    ./cowork --team scout,scout-reviewer --context-file brief.md

    # A stopped run reports stop.request_id and decision_argv; answer it:
    ./cowork --session-file PATH --answer REQUEST_ID --context-file answer.md

    # Continue saved work with nothing to decide:
    ./cowork --session-file PATH

    ./cowork --check                      # preflight dependency check only
"""

import os
import sys

_HERE = os.path.dirname(os.path.realpath(__file__))
_VENV_PY = os.path.join(_HERE, ".venv", "bin", "python")
if os.path.exists(_VENV_PY) and os.path.realpath(sys.executable) != os.path.realpath(_VENV_PY):
    os.execv(_VENV_PY, [_VENV_PY, os.path.realpath(__file__), *sys.argv[1:]])

sys.path.insert(0, os.path.join(_HERE, "scripts"))

import cowork  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(cowork.main())
